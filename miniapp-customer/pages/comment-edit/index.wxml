<view class="page">
  <view class="card">
    <textarea
      class="content-input"
      value="{{content}}"
      maxlength="{{maxContentLength}}"
      placeholder="说说这次购买和到店体验"
      placeholder-class="content-placeholder"
      bindinput="onContentInput"
    />
    <view class="content-count">{{content.length}}/{{maxContentLength}}</view>

    <view class="image-grid">
      <view class="image-item" wx:for="{{images}}" wx:key="*this" wx:for-index="index">
        <image
          class="image"
          src="{{item}}"
          mode="aspectFill"
          data-index="{{index}}"
          bindtap="previewImage"
        />
        <view class="image-remove" data-index="{{index}}" catchtap="removeImage">×</view>
      </view>
      <view class="image-add" wx:if="{{images.length < maxImages}}" bindtap="chooseImage">
        <text class="image-add-icon">+</text>
        <text class="image-add-text">添加图片</text>
      </view>
    </view>
    <text class="image-hint">最多 {{maxImages}} 张，单张不超过 5MB</text>
  </view>

  <view class="footer-placeholder"></view>
  <view class="footer-bar">
    <t-button
      theme="primary"
      size="large"
      block
      loading="{{submitting}}"
      disabled="{{uploading}}"
      bind:tap="submit"
    >
      提交评论
    </t-button>
  </view>
</view>
