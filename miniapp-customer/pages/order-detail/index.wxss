.row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 20rpx 0;
  font-size: 28rpx;
}

.row + .row {
  border-top: 1rpx solid var(--line);
}

.row-label {
  color: var(--text-3);
}

.row-value {
  max-width: 65%;
  text-align: right;
}

.footer-bar t-button {
  flex: 1;
}
