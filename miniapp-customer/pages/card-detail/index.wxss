.face {
  padding: 36rpx;
  margin-bottom: 24rpx;
  color: var(--surface);
  background: linear-gradient(135deg, var(--brand) 0%, var(--brand-deep) 100%);
  border: 1rpx solid var(--gold-line);
  border-radius: var(--radius-card);
}

.face-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.face-name {
  font-size: 32rpx;
  font-weight: 600;
}

.face-times {
  display: flex;
  align-items: baseline;
  margin: 24rpx 0 8rpx;
}

.face-value {
  font-size: 64rpx;
  font-weight: 700;
  color: var(--gold);
  font-variant-numeric: tabular-nums;
}

.face-unit {
  margin-left: 8rpx;
  font-size: 24rpx;
  color: var(--surface);
  opacity: 0.6;
}

.face-valid {
  display: block;
  font-size: 24rpx;
  opacity: 0.8;
}

.face-no {
  display: block;
  margin-top: 8rpx;
  font-size: 22rpx;
  opacity: 0.6;
}

.timeline {
  margin-top: 24rpx;
}

.tl-item {
  display: flex;
  gap: 20rpx;
  padding: 16rpx 0;
}

.tl-dot {
  flex: 0 0 auto;
  width: 16rpx;
  height: 16rpx;
  margin-top: 12rpx;
  background: var(--brand);
  border-radius: 50%;
}

.tl-dot-revoked {
  background: var(--danger);
}

.tl-body {
  flex: 1;
}

.tl-row {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
}

.tl-title {
  font-size: 28rpx;
  font-weight: 600;
}

.tl-time {
  font-size: 22rpx;
}

.tl-desc {
  display: block;
  margin-top: 4rpx;
  font-size: 24rpx;
  color: var(--text-3);
}
