.result {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding-top: 96rpx;
}

.icon-wrap {
  margin-bottom: 24rpx;
}

.result-title {
  font-size: 36rpx;
  font-weight: 600;
}

.result-amount {
  margin-top: 16rpx;
  font-size: 64rpx;
}

.result-desc {
  margin-top: 16rpx;
  font-size: 26rpx;
  color: var(--text-2);
}

.result-order {
  margin-top: 8rpx;
  font-size: 22rpx;
  color: var(--text-3);
}

.actions {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
  width: 100%;
  margin-top: 64rpx;
}
