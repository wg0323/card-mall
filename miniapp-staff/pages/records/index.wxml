<view class="page">
  <view class="filters">
    <picker mode="date" value="{{startDate}}" bindchange="onStartDate">
      <view class="filter {{startDate ? 'filter-on' : ''}}">{{startDate || '开始日期'}}</view>
    </picker>
    <text class="filter-sep">至</text>
    <picker mode="date" value="{{endDate}}" bindchange="onEndDate">
      <view class="filter {{endDate ? 'filter-on' : ''}}">{{endDate || '结束日期'}}</view>
    </picker>
    <view class="filter-clear" wx:if="{{startDate || endDate}}" bindtap="clearDates">清空</view>
  </view>

  <view class="summary muted" wx:if="{{total}}">共 {{total}} 条</view>

  <view class="record" wx:for="{{list}}" wx:key="id">
    <view class="record-head">
      <text class="record-name">{{item.cardName}}</text>
      <t-tag size="small" theme="{{item.statusTheme}}" variant="light">{{item.statusLabel}}</t-tag>
    </view>
    <view class="record-row">
      <text class="muted">{{item.memberNickname || item.memberPhone || '会员'}} · {{item.timesText}}</text>
      <text class="muted">{{item.verifyTime}}</text>
    </view>
    <text class="record-remark" wx:if="{{item.remark}}">{{item.remark}}</text>
  </view>

  <view class="empty-wrap" wx:if="{{!list.length}}">
    <t-empty description="这段时间还没有核销记录" />
  </view>

  <view class="more" wx:if="{{loadingMore}}">
    <t-loading theme="circular" size="40rpx" text="加载中" inherit-color />
  </view>
  <view class="more muted" wx:elif="{{list.length && finished}}">没有更多了</view>
</view>
