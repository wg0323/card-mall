.profile {
  display: flex;
  gap: 24rpx;
  align-items: center;
  padding: 40rpx 32rpx;
  margin-bottom: 24rpx;
  background: var(--surface);
  border-radius: var(--radius-card);
  box-shadow: var(--shadow-card);
}

/* 头像：圆形由 view/image 画，原生 button 只做透明热区 */
.avatar-wrap {
  position: relative;
  flex: none;
  width: 112rpx;
  height: 112rpx;
  overflow: hidden;
  border-radius: 50%;
}

.avatar-hit {
  position: absolute;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  width: 100%;
  height: 100%;
  padding: 0;
  margin: 0;
  opacity: 0;
}

.avatar {
  display: block;
  width: 112rpx;
  height: 112rpx;
  background: var(--brand-light);
  border-radius: 50%;
}

/* 没有头像时用姓名首字占位 */
.avatar-text {
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 40rpx;
  color: var(--brand);
}

.profile-info {
  flex: 1;
  min-width: 0;
}

.profile-name {
  display: block;
  font-size: 32rpx;
  font-weight: 600;
}

.profile-role {
  display: block;
  margin-top: 8rpx;
  font-size: 24rpx;
  color: var(--text-3);
}

/* 菜单卡片与上方个人卡同宽：左右内边距交给 t-cell，不再叠加 */
.card.menu {
  padding: 8rpx 0;
  /* t-cell 自带整块白底，不裁切会盖住卡片四角的圆角 */
  overflow: hidden;
}

.brand-note {
  display: block;
  margin-top: 48rpx;
  font-size: 22rpx;
  color: var(--text-3);
  text-align: center;
}
